<h1>New Entry</h1>

<form action="/entries" method="post">
  <!-- Rails CSRF protection token -->
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

  <!-- Hidden field for the place_id foreign key -->
  <input type="hidden" name="query_place_id" value="<%= @the_place_id %>">

  <div>
    <label for="title">Title:</label>
    <input type="text" id="title" name="query_title">
  </div>

  <div>
    <label for="description">Description:</label>
    <textarea id="description" name="query_description"></textarea>
  </div>

  <div>
    <label for="occurred_on">Date:</label>
    <input type="date" id="occurred_on" name="query_occurred_on">
  </div>

  <button type="submit">Create Entry</button>
</form>

<br>
<a href="/places/<%= @the_place_id %>">Cancel</a>